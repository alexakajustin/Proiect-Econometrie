filter(An == 2023)
if(nrow(df_2023) == 0) {
message("Nu există date complete pentru 2023. Se utilizează 2022.")
df_2023 <- df_total %>% filter(An == 2022)
}
# Adăugare variabilă dummy: Membru_UE_i
non_eu_countries <- c("Switzerland", "Iceland", "Norway", "United Kingdom", "Turkey")
df_final <- df_2023 %>%
mutate(
