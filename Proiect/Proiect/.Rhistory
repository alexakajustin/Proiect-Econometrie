# ==============================================================================
# PROIECT ECONOMETRIE: APLICAȚIA 2 - MODELE CU DATE DE TIP PANEL
# ==============================================================================
# Cerințe:
# 1. Configurare date Panel (Unitate + Timp).
# 2. Testare RE vs FE (Hausman).
# 3. Estimare și Diagnostic.
# ==============================================================================
if (!require("pacman")) install.packages("pacman")
pacman::p_load(readxl, tidyverse, writexl, plm, lmtest, tseries, car)
setwd("C:/Users/Jastin/Desktop/Econometrie/Proiect-Econometrie/Proiect/Proiect")
# Sink Output
sink("Output/Rapoarte/rezultate_panel.txt", split = TRUE)
# ==============================================================================
# 1. Încărcare și Pregătire Date Panel
# ==============================================================================
# Reconstruim df_total din scriptul de cleaning sau il incarcam pe cel salvat
# Pentru siguranta, re-citim fisierele raw cleaned si facem join (ca sa avem toti anii 2019-2023)
data_path <- "Cleaned Data/"
# Citim datele
df_theft <- read_excel(paste0(data_path, "theft_cleaned.xlsx"))
df_gdp <- read_excel(paste0(data_path, "gdp_cleaned.xlsx"))
df_unemp <- read_excel(paste0(data_path, "unemployment_cleaned.xlsx"))
df_immig <- read_excel(paste0(data_path, "immigration_cleaned.xlsx"))
df_pop <- read_excel(paste0(data_path, "population_density_cleaned.xlsx"))
# Funcție helper pivot
process_wide_data <- function(df, val_name) {
if (!"Country" %in% names(df)) names(df)[1] <- "Country"
df %>%
pivot_longer(-Country, names_to = "Year", values_to = val_name) %>%
mutate(Year = as.numeric(Year))
}
# Transformare
df_list <- list(
process_wide_data(df_theft, "Furturi"),
process_wide_data(df_gdp, "PIB"),
process_wide_data(df_unemp, "Someri"),
process_wide_data(df_immig, "Imigratie"),
process_wide_data(df_pop, "Densitate")
)
# Merge recursiv
df_panel <- df_list %>% reduce(left_join, by = c("Country", "Year"))
# Curatare si Transformari
non_eu <- c("Switzerland", "Iceland", "Norway", "United Kingdom", "Turkey")
df_panel_final <- df_panel %>%
mutate(
ln_Furturi = log(Furturi),
ln_PIB = log(PIB),
ln_Someri = log(Someri),
ln_Imigratie = log(Imigratie + 1),
ln_Densitate = log(Densitate),
Membru_UE = ifelse(Country %in% non_eu, 0, 1),
Year = as.factor(Year)
) %>%
filter(!is.na(ln_Furturi) & !is.na(ln_PIB) & !is.na(ln_Someri)) # Eliminam date lipsa
print("Structura Panel:")
print(str(df_panel_final))
# Declarare obiect pdata.frame
pdata <- pdata.frame(df_panel_final, index = c("Country", "Year"))
# ==============================================================================
# 2. Estimare Modele Panel
# ==============================================================================
# A. Model Pooled OLS (Ignora structura panel)
# Nu este recomandat, dar folosim ca baseline
model_pool <- plm(ln_Furturi ~ ln_PIB + ln_Someri + ln_Imigratie + ln_Densitate,
data = pdata, model = "pooling")
# B. Fixed Effects (FE) - Efecte Fixe Individuale
# Presupunem ca exista caracteristici unice per tara care nu variaza in timp
model_fe <- plm(ln_Furturi ~ ln_PIB + ln_Someri + ln_Imigratie + ln_Densitate,
data = pdata, model = "within")
# C. Random Effects (RE) - Efecte Aleatoare
# Presupunem ca diferentele intre tari sunt aleatoare si necorelate cu predictorii
model_re <- plm(ln_Furturi ~ ln_PIB + ln_Someri + ln_Imigratie + ln_Densitate,
data = pdata, model = "random")
# ==============================================================================
# 3. Testare Model (Hausman Test) - Cerința 3
# ==============================================================================
# H0: Modelul Random Effects este consistent (preferat)
# H1: Modelul Fixed Effects este consistent
hausman <- phtest(model_fe, model_re)
print("--- Testul Hausman ---")
print(hausman)
model_ales <- if(hausman$p.value < 0.05) "Fixed Effects" else "Random Effects"
print(paste("Modelul selectat conform Hausman (p < 0.05 -> FE, altfel RE):", model_ales))
final_model <- if(hausman$p.value < 0.05) model_fe else model_re
summary_final <- summary(final_model)
print(summary_final)
# ==============================================================================
# 4. Diagnosticare Panel
# ==============================================================================
# Testare Dependenta Transversala (Pasaran CD) - doar pentru FE/RE
# H0: Nu exista dependenta transversala
test_cd <- pcdtest(final_model, test = "cd")
print("--- Test Pasaran CD (Dependenta Transversala) ---")
print(test_cd)
# Testare Serial Correlation (Breusch-Godfrey/Wooldridge)
test_serial <- pbgtest(final_model)
print("--- Test Serial Correlation ---")
print(test_serial)
# Testare Heteroscedasticitate (Breusch-Pagan pentru Panel)
test_bp_panel <- bptest(ln_Furturi ~ ln_PIB + ln_Someri + ln_Imigratie + ln_Densitate + factor(Country),
data = df_panel_final, studentize = F)
print("--- Test Heteroscedasticitate ---")
print(test_bp_panel)
# ==============================================================================
# 5. Salvare Rezultate
# ==============================================================================
# Extragem coeficientii modelului final
res_df <- as.data.frame(summary_final$coefficients)
res_df$Termen <- rownames(res_df)
res_df <- res_df[, c("Termen", "Estimate", "Std. Error", "t-value", "Pr(>|t|)")]
write_xlsx(res_df, "Output/Rapoarte/Rezultate_Panel_Final.xlsx")
# Salvare rezultate teste diagnostic
diag_df <- data.frame(
Test = c("Hausman", "Pasaran CD", "Serial Correlation", "Heteroscedasticity"),
Statistica = c(hausman$statistic, test_cd$statistic, test_serial$statistic, test_bp_panel$statistic),
P_Value = c(hausman$p.value, test_cd$p.value, test_serial$p.value, test_bp_panel$p.value),
Interpretare = c(
ifelse(hausman$p.value < 0.05, "FE Preferat", "RE Preferat"),
ifelse(test_cd$p.value < 0.05, "Dependenta (Rau)", "Independenta (Bun)"),
ifelse(test_serial$p.value < 0.05, "Autocorelare (Rau)", "Fara Autocorelare (Bun)"),
ifelse(test_bp_panel$p.value < 0.05, "Hetero (Rau)", "Homo (Bun)")
)
)
write_xlsx(diag_df, "Output/Rapoarte/Rezultate_Teste_Panel.xlsx")
print("Analiza Panel Finalizata.")
sink()
# ==============================================================================
# PROIECT ECONOMETRIE: APLICAȚIA 1 - MODELARE ECONOMETRICĂ & ML
# ==============================================================================
if (!require("pacman")) install.packages("pacman")
pacman::p_load(readxl, tidyverse, writexl, broom, car, lmtest, caret, glmnet, Metrics)
setwd("C:/Users/Jastin/Desktop/Econometrie/Proiect-Econometrie/Proiect/Proiect")
# Sink Output
sink("Output/Rapoarte/rezultate_modelare_extins.txt", split = TRUE)
# ==============================================================================
# 1. Încărcare Date (Train / Test)
# ==============================================================================
# Citim aceleasi fisiere generate in EDA
df_final <- read_excel("Output/Date/Date_Proiect_Final_2023.xlsx")
train_data <- read_excel("Output/Date/Date_Antrenare.xlsx")
test_data <- read_excel("Output/Date/Date_Testare.xlsx")
print("Date încărcate. Dimensiuni:")
print(paste("Total:", nrow(df_final)))
print(paste("Train:", nrow(train_data)))
print(paste("Test:", nrow(test_data)))
# ==============================================================================
# 2. Modelare Clasică (OLS) - Pe setul de Antrenare
# ==============================================================================
# Model Simplu (H1)
model_simplu <- lm(ln_Furturi ~ ln_Someri, data = train_data)
write_xlsx(tidy(model_simplu), "Output/Rapoarte/Rezultate_Regresie_Simplu.xlsx")
# Model Multiplu (Complet)
model_multi <- lm(ln_Furturi ~ ln_PIB + ln_Someri + ln_Imigratie + ln_Densitate + Membru_UE, data = train_data)
write_xlsx(tidy(model_multi), "Output/Rapoarte/Rezultate_Regresie_Multipla.xlsx")
# Stepwise Selection (Model Optim)
model_step <- step(model_multi, direction = "both", trace = 0)
summary_step <- summary(model_step)
print("--- Model Optim (Stepwise) ---")
print(summary_step)
write_xlsx(list(Coeficienti = tidy(model_step), Sumar = glance(model_step)), "Output/Rapoarte/Rezultate_Regresie_Refinat.xlsx")
# VIF & Diagnostic pentru Modelul Multiplu
vif_vals <- vif(model_multi)
write_xlsx(data.frame(Variabila = names(vif_vals), VIF = vif_vals), "Output/Rapoarte/Rezultate_VIF.xlsx")
# Diagnostic Tests
shapiro <- shapiro.test(resid(model_multi))
bp <- bptest(model_multi)
dw <- dwtest(model_multi)
df_diag <- data.frame(
Test = c("Shapiro-Wilk", "Breusch-Pagan", "Durbin-Watson"),
Statistica = c(shapiro$statistic, bp$statistic, dw$statistic),
P_Value = c(shapiro$p.value, bp$p.value, dw$p.value),
Concluzie = c(if(shapiro$p.value > 0.05) "Normal" else "Ne-normal",
if(bp$p.value > 0.05) "Homoscedastic" else "Heteroscedastic",
if(dw$p.value > 0.05) "Fara Autocorelare" else "Autocorelare")
)
write_xlsx(df_diag, "Output/Rapoarte/Rezultate_Teste_Diagnostic.xlsx")
# ==============================================================================
# 3. Evaluare Predictivă (Pe setul de Testare) - Cerința 3c
# ==============================================================================
print("--- Evaluare Predictiva (Test Set) ---")
# Predicții
pred_ols <- predict(model_step, newdata = test_data)
# Calcul Metrici
rmse_ols <- rmse(test_data$ln_Furturi, pred_ols)
mae_ols <- mae(test_data$ln_Furturi, pred_ols)
mape_ols <- mean(abs((test_data$ln_Furturi - pred_ols) / test_data$ln_Furturi)) * 100
r2_adj_ols <- summary(model_step)$adj.r.squared
metrics_ols <- data.frame(
Model = "OLS Optim",
RMSE = rmse_ols,
MAE = mae_ols,
MAPE = mape_ols,
R2_Adj = r2_adj_ols
)
print(metrics_ols)
# ==============================================================================
# 4. Regularizare & Machine Learning (Lasso & Ridge) - Cerința 5
# ==============================================================================
print("--- Regularizare (Lasso & Ridge) ---")
# Pregatire matrice (glmnet cere matrice numerica)
x_train <- model.matrix(ln_Furturi ~ ln_PIB + ln_Someri + ln_Imigratie + ln_Densitate + Membru_UE, data = train_data)[,-1]
y_train <- train_data$ln_Furturi
x_test <- model.matrix(ln_Furturi ~ ln_PIB + ln_Someri + ln_Imigratie + ln_Densitate + Membru_UE, data = test_data)[,-1]
y_test <- test_data$ln_Furturi
# --- Ridge (alpha = 0) ---
cv_ridge <- cv.glmnet(x_train, y_train, alpha = 0)
best_lambda_ridge <- cv_ridge$lambda.min
model_ridge <- glmnet(x_train, y_train, alpha = 0, lambda = best_lambda_ridge)
pred_ridge <- predict(model_ridge, s = best_lambda_ridge, newx = x_test)
# Metrici Ridge
rmse_ridge <- rmse(y_test, pred_ridge)
mae_ridge <- mae(y_test, pred_ridge)
r2_ridge <- 1 - sum((y_test - pred_ridge)^2) / sum((y_test - mean(y_test))^2)
# --- Lasso (alpha = 1) ---
cv_lasso <- cv.glmnet(x_train, y_train, alpha = 1)
best_lambda_lasso <- cv_lasso$lambda.min
model_lasso <- glmnet(x_train, y_train, alpha = 1, lambda = best_lambda_lasso)
pred_lasso <- predict(model_lasso, s = best_lambda_lasso, newx = x_test)
# Metrici Lasso
rmse_lasso <- rmse(y_test, pred_lasso)
mae_lasso <- mae(y_test, pred_lasso)
r2_lasso <- 1 - sum((y_test - pred_lasso)^2) / sum((y_test - mean(y_test))^2)
# Salvare Coeficienți ML
coef_ridge <- as.matrix(coef(model_ridge))
coef_lasso <- as.matrix(coef(model_lasso))
df_coefs_ml <- data.frame(
Variabila = rownames(coef_ridge),
Coef_Ridge = coef_ridge[,1],
Coef_Lasso = coef_lasso[,1]
)
write_xlsx(df_coefs_ml, "Output/Rapoarte/Rezultate_Lasso_Ridge.xlsx")
# Plot Lasso Trace
png("Output/Grafice/Lasso_Trace.png", width = 800, height = 600)
plot(glmnet(x_train, y_train, alpha = 1), xvar = "lambda", label = TRUE)
title("Lasso Trace Plot", line = 2.5)
dev.off()
# ==============================================================================
# 5. Comparație Finală (Performance Table)
# ==============================================================================
metrics_final <- rbind(
metrics_ols,
data.frame(Model = "Ridge", RMSE = rmse_ridge, MAE = mae_ridge, MAPE = NA, R2_Adj = r2_ridge),
data.frame(Model = "Lasso", RMSE = rmse_lasso, MAE = mae_lasso, MAPE = NA, R2_Adj = r2_lasso)
)
print("--- Tabel Comparativ Performanta ---")
print(metrics_final)
write_xlsx(metrics_final, "Output/Rapoarte/Rezultate_Predictie_Comparativ.xlsx")
# ==============================================================================
# 6. Scenariu de Prognoză (Cerința 4b)
# ==============================================================================
# Scenariu "Criza": Somaj +50%, PIB -20% (fata de media din Train)
avg_data <- train_data %>% summarise(
ln_PIB = mean(ln_PIB),
ln_Someri = mean(ln_Someri),
ln_Imigratie = mean(ln_Imigratie),
ln_Densitate = mean(ln_Densitate),
Membru_UE = 1
)
scenariu_criza <- avg_data %>%
mutate(
ln_Someri = log(exp(ln_Someri) * 1.5), # +50%
ln_PIB = log(exp(ln_PIB) * 0.8)        # -20%
)
prog_val <- predict(model_step, newdata = scenariu_criza, interval = "confidence")
prog_df <- data.frame(
Scenariu = "Criza Economica",
Furturi_Estimat = exp(prog_val[1]),
Limita_Inf = exp(prog_val[2]),
Limita_Sup = exp(prog_val[3])
)
write_xlsx(prog_df, "Output/Rapoarte/Rezultate_Prognoza.xlsx")
print("Script App 1 Finalizat.")
sink()
